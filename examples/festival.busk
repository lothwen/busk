# Festival Main Stage: a complete festival show on the TupperDMX profiles,
# built with console commands only. Build it once on a new show:
#
#   busk new festival.show --title "Festival Main Stage"
#   busk run festival.show --library examples/tupperdmx/profiles \
#       --script examples/tupperdmx/festival.busk
#
# It saves festival.show, which embeds the profiles; after that,
# `busk run festival.show` plays it. The output goes to TupperDMX's simulator
# over Art-Net on 127.0.0.1 (see "output" below for a real rig).
#
# ------------------------------------------------------------------ the rig
# 54 fixtures on one universe (506 of 512 channels, the one universe TupperDMX
# simulates). Every row is numbered from stage left to stage right.
#
#   FOH truss        301-308  8 PAR RGBW             frontlight
#   Front truss      101-106  6 Moving Head (spots)  downstage, hung
#                    501-504  4 Blinder              audience blinders
#   Mid truss        201-206  6 Moving Head (washes) hung
#   Back truss       107-112  6 Moving Head (spots)  upstage, hung
#                    309-316  8 PAR RGBW             colour backlight
#   Upstage floor    207-212  6 Moving Head (washes) standing
#                    401-404  4 LED Bar              riser front
#                    505-508  4 Blinder              stage strobes
#                    601-602  2 Smoke Machine        stage left, stage right
#   Downstage lip    405-408  4 LED Bar              facing the audience
#
#   Patch (universe 1): spots 1-144, washes 145-288, PARs 289-384,
#   LED bars 385-440, blinders 441-504, smoke 505 and 506.
#
# The 24 moving heads share one profile: the spots run gobos, prisms and
# narrow zoom, the washes run open and wide. The blinders are the strobes:
# four white cells (cold 1-2, warm 3-4) and a strobe channel. A smoke
# machine's intensity is its fog output, so no look that lights "the stage"
# ever names the smoke machines: only group 7 does.
#
# ------------------------------------------------------------------- numbers
#   groups    1-9 by fixture type, 11-16 by position, 21-27 by purpose,
#             31-40 rig rows and blinder cells (used to record presets)
#   presets   color 1-10, position 1-7 (spots) and 11-17 (washes),
#             beam 1-8, intensity 1-5 (Dimmer 0/25/50/75/100%)
#   playbacks page P, slot S holds playback (and cue list) P*100+S
#
# -------------------------------------------------------------------- pages
#   1 Songs              Song 1-3 (GO, BACK, GOTO), Busking FX, Special Looks
#   2 Colors             ten colours and three colour effects, one at a time
#   3 Positions & Beams  positions 1-7 and beams 11-18, one of each at a time
#   4 Movement FX        spots 1-5 and washes 11-15, one per type at a time
#   5 Dimmer FX          sine, square, chase, pulse, alternating
#   6 Strobes & SFX      strobes (flash), blinder hit, smoke, LED bar programs
#   7 House & Audience   house lights, audience lighting, MC light
#
# Slots 9 and 10 of every page hold the emergency playbacks: HOUSE FULL and
# PANIC WORK LIGHT. Both play at band 200, above everything, kill the fog,
# open every shutter and survive a swop. The web remote's header always has
# blackout, the grand master, TAP and the other masters: the speed masters
# "Beat" (songs, dimmer and colour effects) and "Move Speed" (movement
# effects), the size masters "Move Size" and "FX Size", a group master per
# fixture type (with "Smoke" as the fog level) and the fade-time master.
#
# Every position below is a starting point for the focus call: aim the heads
# in the venue and record the presets again with `merge`.

# ===================================================================== patch
universe add 1 "Stage"
fixture add 101 thru 112 "TupperDMX Moving Head" mode 12ch at 1.1
fixture add 201 thru 212 "TupperDMX Moving Head" mode 12ch at 1.145
fixture add 301 thru 316 "TupperDMX PAR RGBW" mode 6ch at 1.289
fixture add 401 thru 408 "TupperDMX LED Bar" mode 7ch at 1.385
fixture add 501 thru 508 "TupperDMX Blinder" mode 8ch at 1.441
fixture add 601 thru 602 "TupperDMX Smoke Machine" mode 1ch at 1.505

# ----------------------------------------------------------------- positions
# Where each fixture hangs or stands, for a 3D view of the stage
# (stage3d_bar.py): metres from the middle of the stage's downstage edge at
# deck height, x towards stage right, y downstage (into the audience), z up.
# rx, ry and rz are degrees, turned about x, then y, then z: at 0 a fixture
# stands on its base with its beam straight up, so a hung one is rx 180.
# Trusses: FOH 8 m out at 6 m, front at y -1 (6.5 m), mid at -4 (7 m), back
# at -7 (7.5 m: the heads on its front chord, the PARs on its back one).
# FOH truss: PARs, frontlight on the stage
fixture 301 location {"x": -5.25, "y": 8, "z": 6, "rx": 120, "ry": 0, "rz": 0}
fixture 302 location {"x": -3.75, "y": 8, "z": 6, "rx": 120, "ry": 0, "rz": 0}
fixture 303 location {"x": -2.25, "y": 8, "z": 6, "rx": 120, "ry": 0, "rz": 0}
fixture 304 location {"x": -0.75, "y": 8, "z": 6, "rx": 120, "ry": 0, "rz": 0}
fixture 305 location {"x": 0.75, "y": 8, "z": 6, "rx": 120, "ry": 0, "rz": 0}
fixture 306 location {"x": 2.25, "y": 8, "z": 6, "rx": 120, "ry": 0, "rz": 0}
fixture 307 location {"x": 3.75, "y": 8, "z": 6, "rx": 120, "ry": 0, "rz": 0}
fixture 308 location {"x": 5.25, "y": 8, "z": 6, "rx": 120, "ry": 0, "rz": 0}
# front truss: spots, hung
fixture 101 location {"x": -6.25, "y": -1, "z": 6.5, "rx": 180, "ry": 0, "rz": 0}
fixture 102 location {"x": -3.75, "y": -1, "z": 6.5, "rx": 180, "ry": 0, "rz": 0}
fixture 103 location {"x": -1.25, "y": -1, "z": 6.5, "rx": 180, "ry": 0, "rz": 0}
fixture 104 location {"x": 1.25, "y": -1, "z": 6.5, "rx": 180, "ry": 0, "rz": 0}
fixture 105 location {"x": 3.75, "y": -1, "z": 6.5, "rx": 180, "ry": 0, "rz": 0}
fixture 106 location {"x": 6.25, "y": -1, "z": 6.5, "rx": 180, "ry": 0, "rz": 0}
# front truss: blinders, between the spots, at the audience
fixture 501 location {"x": -5, "y": -1, "z": 6.5, "rx": -120, "ry": 0, "rz": 0}
fixture 502 location {"x": -2.5, "y": -1, "z": 6.5, "rx": -120, "ry": 0, "rz": 0}
fixture 503 location {"x": 2.5, "y": -1, "z": 6.5, "rx": -120, "ry": 0, "rz": 0}
fixture 504 location {"x": 5, "y": -1, "z": 6.5, "rx": -120, "ry": 0, "rz": 0}
# mid truss: washes, hung
fixture 201 location {"x": -6.25, "y": -4, "z": 7, "rx": 180, "ry": 0, "rz": 0}
fixture 202 location {"x": -3.75, "y": -4, "z": 7, "rx": 180, "ry": 0, "rz": 0}
fixture 203 location {"x": -1.25, "y": -4, "z": 7, "rx": 180, "ry": 0, "rz": 0}
fixture 204 location {"x": 1.25, "y": -4, "z": 7, "rx": 180, "ry": 0, "rz": 0}
fixture 205 location {"x": 3.75, "y": -4, "z": 7, "rx": 180, "ry": 0, "rz": 0}
fixture 206 location {"x": 6.25, "y": -4, "z": 7, "rx": 180, "ry": 0, "rz": 0}
# back truss, front chord: spots, hung
fixture 107 location {"x": -6.25, "y": -6.85, "z": 7.5, "rx": 180, "ry": 0, "rz": 0}
fixture 108 location {"x": -3.75, "y": -6.85, "z": 7.5, "rx": 180, "ry": 0, "rz": 0}
fixture 109 location {"x": -1.25, "y": -6.85, "z": 7.5, "rx": 180, "ry": 0, "rz": 0}
fixture 110 location {"x": 1.25, "y": -6.85, "z": 7.5, "rx": 180, "ry": 0, "rz": 0}
fixture 111 location {"x": 3.75, "y": -6.85, "z": 7.5, "rx": 180, "ry": 0, "rz": 0}
fixture 112 location {"x": 6.25, "y": -6.85, "z": 7.5, "rx": 180, "ry": 0, "rz": 0}
# back truss, back chord: PARs, backlight
fixture 309 location {"x": -7, "y": -7.15, "z": 7.5, "rx": -150, "ry": 0, "rz": 0}
fixture 310 location {"x": -5, "y": -7.15, "z": 7.5, "rx": -150, "ry": 0, "rz": 0}
fixture 311 location {"x": -3, "y": -7.15, "z": 7.5, "rx": -150, "ry": 0, "rz": 0}
fixture 312 location {"x": -1, "y": -7.15, "z": 7.5, "rx": -150, "ry": 0, "rz": 0}
fixture 313 location {"x": 1, "y": -7.15, "z": 7.5, "rx": -150, "ry": 0, "rz": 0}
fixture 314 location {"x": 3, "y": -7.15, "z": 7.5, "rx": -150, "ry": 0, "rz": 0}
fixture 315 location {"x": 5, "y": -7.15, "z": 7.5, "rx": -150, "ry": 0, "rz": 0}
fixture 316 location {"x": 7, "y": -7.15, "z": 7.5, "rx": -150, "ry": 0, "rz": 0}
# upstage floor: washes, standing
fixture 207 location {"x": -6.25, "y": -6, "z": 0, "rx": 0, "ry": 0, "rz": 0}
fixture 208 location {"x": -3.75, "y": -6, "z": 0, "rx": 0, "ry": 0, "rz": 0}
fixture 209 location {"x": -1.25, "y": -6, "z": 0, "rx": 0, "ry": 0, "rz": 0}
fixture 210 location {"x": 1.25, "y": -6, "z": 0, "rx": 0, "ry": 0, "rz": 0}
fixture 211 location {"x": 3.75, "y": -6, "z": 0, "rx": 0, "ry": 0, "rz": 0}
fixture 212 location {"x": 6.25, "y": -6, "z": 0, "rx": 0, "ry": 0, "rz": 0}
# riser front: LED bars at the audience
fixture 401 location {"x": -4.5, "y": -5, "z": 0.25, "rx": -90, "ry": 0, "rz": 0}
fixture 402 location {"x": -1.5, "y": -5, "z": 0.25, "rx": -90, "ry": 0, "rz": 0}
fixture 403 location {"x": 1.5, "y": -5, "z": 0.25, "rx": -90, "ry": 0, "rz": 0}
fixture 404 location {"x": 4.5, "y": -5, "z": 0.25, "rx": -90, "ry": 0, "rz": 0}
# upstage floor: stage strobes, tipped up at the audience
fixture 505 location {"x": -7, "y": -5.5, "z": 0.25, "rx": -80, "ry": 0, "rz": 0}
fixture 506 location {"x": -3, "y": -5.5, "z": 0.25, "rx": -80, "ry": 0, "rz": 0}
fixture 507 location {"x": 3, "y": -5.5, "z": 0.25, "rx": -80, "ry": 0, "rz": 0}
fixture 508 location {"x": 7, "y": -5.5, "z": 0.25, "rx": -80, "ry": 0, "rz": 0}
# smoke: stage left and stage right, blowing on stage
fixture 601 location {"x": -7.5, "y": -3, "z": 0.15, "rx": -90, "ry": 0, "rz": -90}
fixture 602 location {"x": 7.5, "y": -3, "z": 0.15, "rx": -90, "ry": 0, "rz": 90}
# downstage lip: LED bars at the audience
fixture 405 location {"x": -4.5, "y": -0.15, "z": 0.05, "rx": -90, "ry": 0, "rz": 0}
fixture 406 location {"x": -1.5, "y": -0.15, "z": 0.05, "rx": -90, "ry": 0, "rz": 0}
fixture 407 location {"x": 1.5, "y": -0.15, "z": 0.05, "rx": -90, "ry": 0, "rz": 0}
fixture 408 location {"x": 4.5, "y": -0.15, "z": 0.05, "rx": -90, "ry": 0, "rz": 0}

# What each profile is, so a display draws it right: a head, a can, a bar.
profile "TupperDMX Moving Head" category spot
profile "TupperDMX PAR RGBW" category par
profile "TupperDMX LED Bar" category pixel
profile "TupperDMX Blinder" category blinder
profile "TupperDMX Smoke Machine" category fog

# -------------------------------------------------------------------- output
# TupperDMX's simulator: Art-Net Port-Address 0.0.0 (its universe 0) on this
# machine. For a real rig, use `route add 1 sacn 1` (and --iface) instead.
route add 1 artnet 0.0.0 unicast 127.0.0.1

# ==================================================================== groups
# ------------------------------------------------ rig rows (31-40)
sel fixture 101 thru 106
record group 31 "Front Truss Spots"
sel fixture 107 thru 112
record group 32 "Back Truss Spots"
sel fixture 201 thru 206
record group 33 "Mid Truss Washes"
sel fixture 207 thru 212
record group 34 "Floor Washes"
sel fixture 309 thru 316
record group 35 "Back PARs"
sel fixture 401 thru 404
record group 36 "Riser LED Bars"
sel fixture 405 thru 408
record group 37 "Lip LED Bars"
sel fixture 501 thru 504
record group 38 "Audience Blinders"
sel fixture 505 thru 508
record group 39 "Stage Strobes"
sel 501.3 thru 501.4, 502.3 thru 502.4, 503.3 thru 503.4, 504.3 thru 504.4
record group 40 "Audience Blinders Warm"

# ------------------------------------------------ A. by fixture type (1-9)
sel fixture 101 thru 112
record group 1 "All Spots"
sel fixture 201 thru 212
record group 2 "All Washes"
sel fixture 401 thru 408
record group 3 "All LED Bars"
sel fixture 301 thru 316
record group 4 "All PARs"
sel fixture 501 thru 508
record group 5 "All Strobes"
sel group 1, group 2
record group 6 "All Moving Heads"
sel fixture 601 thru 602
record group 7 "Smoke Machines"
sel group 6, group 4, group 3
record group 8 "All Colour"                     # everything that mixes colour
sel group 8, group 5
record group 9 "Full Stage"                     # every light, never the smoke

# ------------------------------------------------ B. by position (11-16)
# FOH is its own position: Stage Left and Right, Upstage, Downstage and
# Center are the fixtures over and on the stage.
sel fixture 101 thru 103, fixture 107 thru 109, fixture 201 thru 203, fixture 207 thru 209, fixture 309 thru 312, fixture 401 thru 402, fixture 405 thru 406, fixture 501 thru 502, fixture 505 thru 506
record group 11 "Stage Left"
sel fixture 104 thru 106, fixture 110 thru 112, fixture 204 thru 206, fixture 210 thru 212, fixture 313 thru 316, fixture 403 thru 404, fixture 407 thru 408, fixture 503 thru 504, fixture 507 thru 508
record group 12 "Stage Right"
sel group 32, group 34, group 35, group 36, group 39
record group 13 "Upstage"
sel group 31, group 37, group 38
record group 14 "Downstage"
sel fixture 103 thru 104, fixture 109 thru 110, fixture 203 thru 204, fixture 209 thru 210, fixture 304 thru 305, fixture 312 thru 313, fixture 402 thru 403, fixture 406 thru 407, fixture 502 thru 503, fixture 506 thru 507
record group 15 "Center"
sel fixture 301 thru 308
record group 16 "FOH"

# ------------------------------------------------ C. by purpose (21-27)
sel fixture 102, 104, 106, 108, 110, 112
record group 21 "Spots Even"
sel fixture 101, 103, 105, 107, 109, 111
record group 22 "Spots Odd"
sel fixture 202, 204, 206, 208, 210, 212
record group 23 "Washes Even"
sel fixture 201, 203, 205, 207, 209, 211
record group 24 "Washes Odd"
sel group 32, group 34, group 35, group 36
record group 25 "Backlight"
sel group 16, group 33
record group 26 "Frontlight"                    # FOH PARs and the mid-truss washes
sel group 38, group 37
record group 27 "Audience Lights"
clear

# =================================================================== presets
# ------------------------------------------------ 5.1 position presets
# Separate presets per fixture type: spots 1-7, washes 11-17. Inside each,
# every truss gets its own values. Hung heads: tilt 0 points down, positive
# tilts downstage. Standing heads (floor washes): tilt 0 points up, positive
# tilts downstage, and pan runs the other way. A spread runs across the row,
# stage left to stage right.

# Position 1 - Center Stage
sel group 31
set pan spread -25 25
set tilt -35
sel group 32
set pan spread -25 25
set tilt 35
record preset position 1 "Spots Center Stage"
clear
sel group 33
set pan spread -20 20
set tilt -10
sel group 34
set pan spread 20 -20
set tilt 45
record preset position 11 "Washes Center Stage"
clear

# Position 2 - Stage Left
sel group 31
set pan spread 10 45
set tilt -30
sel group 32
set pan spread 10 45
set tilt 30
record preset position 2 "Spots Stage Left"
clear
sel group 33
set pan spread 10 40
set tilt -10
sel group 34
set pan spread -40 -10
set tilt 45
record preset position 12 "Washes Stage Left"
clear

# Position 3 - Stage Right
sel group 31
set pan spread -45 -10
set tilt -30
sel group 32
set pan spread -45 -10
set tilt 30
record preset position 3 "Spots Stage Right"
clear
sel group 33
set pan spread -40 -10
set tilt -10
sel group 34
set pan spread 10 40
set tilt 45
record preset position 13 "Washes Stage Right"
clear

# Position 4 - Upstage
sel group 31
set pan spread -15 15
set tilt -55
sel group 32
set pan spread -15 15
set tilt -10
record preset position 4 "Spots Upstage"
clear
sel group 33
set pan spread -15 15
set tilt -40
sel group 34
set pan spread 10 -10                           # floor washes: columns of light
set tilt 15
record preset position 14 "Washes Upstage"
clear

# Position 5 - Downstage
sel group 31
set pan spread -20 20
set tilt 10
sel group 32
set pan spread -20 20
set tilt 50
record preset position 5 "Spots Downstage"
clear
sel group 33
set pan spread -20 20
set tilt 25
sel group 34
set pan spread 20 -20
set tilt 70
record preset position 15 "Washes Downstage"
clear

# Position 6 - Audience
sel group 31
set pan spread -40 40
set tilt 75
sel group 32
set pan spread -35 35
set tilt 85
record preset position 6 "Spots Audience"
clear
sel group 33
set pan spread -40 40
set tilt 70
sel group 34
set pan spread 35 -35
set tilt 80
record preset position 16 "Washes Audience"
clear

# Position 7 - Cross Stage: each side aims at the other
sel group 31
set pan spread -50 50
set tilt -30
sel group 32
set pan spread -50 50
set tilt 30
record preset position 7 "Spots Cross Stage"
clear
sel group 33
set pan spread -45 45
set tilt -10
sel group 34
set pan spread 45 -45
set tilt 40
record preset position 17 "Washes Cross Stage"
clear

# ------------------------------------------------ 5.2 colour presets (global)
sel group 8
set color 1 1 1
record preset color 1 "Open White"
set color 1 0 0
record preset color 2 "Red"
set color 0 0 1
record preset color 3 "Blue"
set color 0 1 0
record preset color 4 "Green"
set color 1 0.5 0
record preset color 5 "Amber"
set color 0 1 1
record preset color 6 "Cyan"
set color 1 0 1
record preset color 7 "Magenta"
set color 1 0.7 0.4
record preset color 8 "CTO"
set color 0.7 0.5 1
record preset color 9 "Lavender"
set color 0.25 0 1
record preset color 10 "Deep Blue"
clear

# ------------------------------------------------ 5.3 beam presets (moving heads)
# The head has no frost: Soft Beam is the widest zoom with the Dots gobo
# turning slowly, which breaks up the edge of the beam.
sel group 6
set gobo1 open
set gobo1Rotation 0
set prism off
set zoom 20
record preset beam 1 "Open Beam"
set zoom 12
record preset beam 2 "Narrow Beam"
set zoom 30
record preset beam 3 "Wide Beam"
set gobo1 breakup
set gobo1Rotation 45
set zoom 18
record preset beam 4 "Gobo 1"
set gobo1 star
set gobo1Rotation -30
record preset beam 5 "Gobo 2"
set gobo1 open
set gobo1Rotation 0
set prism prism3
set zoom 20
record preset beam 6 "Prism"
set zoom 12
record preset beam 7 "Narrow Prism"
set gobo1 dots
set gobo1Rotation 8
set prism off
set zoom 28
record preset beam 8 "Soft Beam"
clear

# ------------------------------------------------ 5.5 dimmer presets (global)
sel group 9
set intensity 0
record preset intensity 1 "Dimmer 0%"
set intensity 25%
record preset intensity 2 "Dimmer 25%"
set intensity 50%
record preset intensity 3 "Dimmer 50%"
set intensity 75%
record preset intensity 4 "Dimmer 75%"
set intensity 100%
record preset intensity 5 "Dimmer 100%"
clear

# =================================================================== masters
# "Beat" is the first speed master, so the web remote's TAP drives it; songs,
# dimmer and colour effects follow it. Movement effects run in Hz, scaled by
# the "Move Speed" fader's multiplier (x1/4 ... x4), free of the music.
master add speed "Beat" bpm 128
master add speed "Move Speed" bpm 120
master add size "Move Size"
master add size "FX Size"
master add group "Spots" group 1
master add group "Washes" group 2
master add group "PARs" group 4
master add group "LED Bars" group 3
master add group "Strobes" group 5
master add group "Smoke" group 7                # the fog level
master add fadetime "Fade"

# ============================================================ effect library
# The built-in Circle, Chase, Pulse and Rainbow join the show when first used.
# 6.1 dimmer effects
effect template add "Sine Wave" [{"attribute": "intensity", "waveform": {"kind": "sine"}, "phaseOffset": 0, "mode": "absolute"}]
effect template add "Square Wave" [{"attribute": "intensity", "waveform": {"kind": "square", "duty": 0.5}, "phaseOffset": 0, "mode": "absolute"}]
effect template add "Alternating Dimmer" [{"attribute": "intensity", "waveform": {"kind": "square", "duty": 0.5}, "phaseOffset": 0, "mode": "absolute"}]
# 6.2 movement effects: offsets around the current position (size in degrees).
# Figure Eight: pan once and tilt twice per cycle.
effect template add "Figure Eight" [{"attribute": "pan", "waveform": {"kind": "sine"}, "phaseOffset": 0, "mode": "add"}, {"attribute": "tilt", "waveform": {"kind": "curve", "points": [[0, 0.5], [0.0625, 0.8536], [0.125, 1], [0.1875, 0.8536], [0.25, 0.5], [0.3125, 0.1464], [0.375, 0], [0.4375, 0.1464], [0.5, 0.5], [0.5625, 0.8536], [0.625, 1], [0.6875, 0.8536], [0.75, 0.5], [0.8125, 0.1464], [0.875, 0], [0.9375, 0.1464], [1, 0.5]]}, "phaseOffset": 0, "mode": "add"}]
effect template add "Pan Sweep" [{"attribute": "pan", "waveform": {"kind": "sine"}, "phaseOffset": 0, "mode": "add"}]
effect template add "Tilt Sweep" [{"attribute": "tilt", "waveform": {"kind": "sine"}, "phaseOffset": 0, "mode": "add"}]
effect template add "Random Movement" [{"attribute": "pan", "waveform": {"kind": "random", "smooth": true, "seed": 7}, "phaseOffset": 0, "mode": "add"}, {"attribute": "tilt", "waveform": {"kind": "random", "smooth": true, "seed": 13}, "phaseOffset": 0, "mode": "add"}]
# 6.3 colour effects
effect template add "Red/Blue Alternation" [{"attribute": "color", "palette": [{"r": 1, "g": 0, "b": 0}, {"r": 0, "g": 0, "b": 1}], "blend": "snap", "mode": "absolute"}]
effect template add "Color Chase" [{"attribute": "color", "palette": [{"r": 1, "g": 0, "b": 0}, {"r": 1, "g": 0.5, "b": 0}, {"r": 0, "g": 1, "b": 0}, {"r": 0, "g": 1, "b": 1}, {"r": 0, "g": 0, "b": 1}, {"r": 1, "g": 0, "b": 1}], "blend": "snap", "mode": "absolute"}]

# ===================================================================== pages
rename page 1 "Songs"
page add 2 "Colors"
page add 3 "Positions & Beams"
page add 4 "Movement FX"
page add 5 "Dimmer FX"
page add 6 "Strobes & SFX"
page add 7 "House & Audience"

# ========================================================= page 1: the songs
# Tracking stacks: each cue stores only what changes, the rest tracks on.
# Timing follows the attribute: dimmer over the cue's time, then position,
# colour and beam each over their own (2 / 4 / 1 / 0.5 s in a normal cue).
# Effects carry stable ids (move, wmove, dim, col): a later cue with the same
# id replaces the effect, and a cue's release of its attributes stops it,
# while the values the cue sets itself stay.

# --------------------------------------- Song 1 "Opener" (cue list 101)
cuelist add 101 "Song 1 Opener"
cuelist 101 tracking true

# 1 Intro: dark stage, blue backlight, haze for the beams.
sel group 25
preset intensity 3
preset color 3
sel group 32
preset position 1
preset beam 1
sel group 34
preset position 14
preset beam 3
sel group 7
set intensity 40%
record cue 101/1 "Intro"
cue 101/1 time 3
cue 101/1 time position 0

# 2 Build Up: the spots join in lavender and start to circle.
sel group 1
preset intensity 4
preset color 9
preset beam 2
sel group 31
preset position 1
sel group 1
effect add "Circle" id move bpm "Beat" x 0.25 size 15 phase 0 360 fadein 4
sel group 33
preset intensity 3
preset color 3
preset position 11
preset beam 3
sel group 35, group 36
preset intensity 4
record cue 101/2 "Build Up"
cue 101/2 time 2
cue 101/2 time position 4
cue 101/2 time color 1
cue 101/2 time beam 0.5

# 3 Drop: full intensity, white beams fanning over the crowd.
sel group 6, group 4, group 3
preset intensity 5
preset color 1
sel group 6
preset beam 2
sel group 1
preset position 6
effect add "Pan Sweep" id move bpm "Beat" x 0.5 size 25 phase 0 180 wings 2
sel group 2
preset position 14
