playback 404 buttons ["toggle", "flash", "release"]
playback 405 buttons ["toggle", "flash", "release"]
playback 411 buttons ["toggle", "flash", "release"]
playback 412 buttons ["toggle", "flash", "release"]
playback 413 buttons ["toggle", "flash", "release"]
playback 414 buttons ["toggle", "flash", "release"]
playback 415 buttons ["toggle", "flash", "release"]

# ======================================================= page 5: dimmer FX
# On the beat of "Beat", sized by their faders and the "FX Size" master. The
# absolute ones light their fixtures by themselves; Pulse dims what is up.
sel group 1
effect add "Sine Wave" id dim bpm "Beat" x 0.5 low 0 high 1 phase 0 360 sizemaster "FX Size"
cuelist add 501 "Sine Spots"
record cue 501/1
clear
sel group 2
effect add "Sine Wave" id dim bpm "Beat" x 0.5 low 0 high 1 phase 0 360 wings 2 sizemaster "FX Size"
cuelist add 502 "Sine Washes"
record cue 502/1
clear
sel group 4
effect add "Square Wave" id dim bpm "Beat" x 1 low 0 high 1 phase 0 360 sizemaster "FX Size"
cuelist add 503 "Square PARs"
record cue 503/1
clear
sel group 3
effect add "Chase" id dim bpm "Beat" x 1 low 0 high 1 phase 0 360 sizemaster "FX Size"
cuelist add 504 "Chase Bars"
record cue 504/1
clear
sel group 5
effect add "Chase" id dim bpm "Beat" x 1 low 0 high 1 phase 0 360 blocks 4 sizemaster "FX Size"
cuelist add 505 "Chase Strobes"
record cue 505/1
clear
sel group 9
effect add "Pulse" id dim bpm "Beat" x 1 size 0.7 sizemaster "FX Size"
cuelist add 506 "Pulse Stage"
record cue 506/1
clear
sel group 6
effect add "Alternating Dimmer" id dim bpm "Beat" x 0.5 low 0 high 1 phase 0 360 groups 2 sizemaster "FX Size"
cuelist add 507 "Alternate Heads"
record cue 507/1
clear
sel group 4
effect add "Alternating Dimmer" id dim bpm "Beat" x 0.5 low 0 high 1 phase 0 360 groups 2 sizemaster "FX Size"
cuelist add 508 "Alternate PARs"
record cue 508/1
clear

playback add 501 cuelist 501 at 5.1 "Sine Spots"
playback add 502 cuelist 502 at 5.2 "Sine Washes"
playback add 503 cuelist 503 at 5.3 "Square PARs"
playback add 504 cuelist 504 at 5.4 "Chase Bars"
playback add 505 cuelist 505 at 5.5 "Chase Strobes"
playback add 506 cuelist 506 at 5.6 "Pulse Stage"
playback add 507 cuelist 507 at 5.7 "Alternate Heads"
playback add 508 cuelist 508 at 5.8 "Alternate PARs"
playback 501 fader size
playback 502 fader size
playback 503 fader size
playback 504 fader size
playback 505 fader size
playback 506 fader size
playback 507 fader size
playback 508 fader size
playback 501 buttons ["toggle", "flash", "release"]
playback 502 buttons ["toggle", "flash", "release"]
playback 503 buttons ["toggle", "flash", "release"]
playback 504 buttons ["toggle", "flash", "release"]
playback 505 buttons ["toggle", "flash", "release"]
playback 506 buttons ["toggle", "flash", "release"]
playback 507 buttons ["toggle", "flash", "release"]
playback 508 buttons ["toggle", "flash", "release"]

# ============================================ page 6: strobes and SFX
# Strobes come first on the flash button; the fader sets their level. The
# strobe cap (safety, below) holds every strobe at 10 Hz at most.
sel group 5
preset intensity 5
set shutter strobe
set strobeRate 10
cuelist add 601 "Strobes"
record cue 601/1
clear
sel group 6
preset intensity 5
preset color 1
set shutter strobe
set strobeRate 12
cuelist add 602 "Strobe Heads"
record cue 602/1
clear
sel group 4
preset intensity 5
preset color 1
set shutter strobe
set strobeRate 12
cuelist add 603 "Strobe PARs"
record cue 603/1
clear
sel group 3
preset intensity 5
preset color 1
set effect strobo                               # the bars' own strobe program
set effectRate 100%
cuelist add 604 "Strobe Bars"
record cue 604/1
clear
sel group 38
preset intensity 5
cuelist add 605 "Blinder Hit"
record cue 605/1
clear
sel group 7
preset intensity 5
cuelist add 606 "Smoke"                         # the fader is the fog output
record cue 606/1
clear
sel group 3
preset intensity 5
set effect fuego
set effectRate 70%
cuelist add 607 "Bars Fire"
record cue 607/1
clear
sel group 3
preset intensity 5
set effect starfield
set effectRate 40%
cuelist add 608 "Bars Starfield"
record cue 608/1
clear

playback add 601 cuelist 601 at 6.1 "Strobes"
playback add 602 cuelist 602 at 6.2 "Strobe Heads"
playback add 603 cuelist 603 at 6.3 "Strobe PARs"
playback add 604 cuelist 604 at 6.4 "Strobe Bars"
playback add 605 cuelist 605 at 6.5 "Blinder Hit"
playback add 606 cuelist 606 at 6.6 "Smoke"
playback add 607 cuelist 607 at 6.7 "Bars Fire"
playback add 608 cuelist 608 at 6.8 "Bars Starfield"
playback 601 buttons ["flash", "toggle", "release"]
playback 602 buttons ["flash", "toggle", "release"]
playback 603 buttons ["flash", "toggle", "release"]
playback 604 buttons ["flash", "toggle", "release"]
playback 605 buttons ["flash", "toggle", "release"]
playback 606 buttons ["toggle", "flash", "release"]
playback 607 buttons ["toggle", "flash", "release"]
playback 608 buttons ["toggle", "flash", "release"]
playback 601 releaseTime 0
playback 602 releaseTime 0
playback 603 releaseTime 0
playback 604 releaseTime 0
playback 605 releaseTime 0.5
playback 606 releaseTime 0
playback 604 exclusivity bar-program            # one LED bar program at a time
playback 607 exclusivity bar-program
playback 608 exclusivity bar-program

# =========================================== page 7: house and audience
# There are no house-light dimmers in this rig: the audience blinders' warm
# cells, the lip LED bars and the FOH PARs light the crowd.

# --------------------------------------- House Lights (cue list 701)
cuelist add 701 "House Lights"
sel group 40
set intensity 60%
sel group 37
set intensity 50%
preset color 8
sel group 35
set intensity 30%
preset color 10
record cue 701/1 "Walk-in"
sel group 40
set intensity 30%
sel group 37
set intensity 25%
record cue 701/2 "House to Half"
sel group 40, group 37, group 35
preset intensity 1
record cue 701/3 "House Out"
clear
sel group 40
set intensity 40%
sel group 37
set intensity 40%
preset color 8
sel group 26
set intensity 60%
preset color 8
sel group 33
preset position 11
preset beam 3
record cue 701/4 "Changeover"
clear
sel group 40
preset intensity 5
sel group 37
set intensity 80%
preset color 1
sel group 16
set intensity 60%
preset color 1
record cue 701/5 "End of Show"
clear
cue 701/1 time 3
cue 701/2 time 5
cue 701/3 time 5
cue 701/4 time 3
cue 701/5 time 3

# --------------------------------------- Audience Lighting (cue list 702)
cuelist add 702 "Audience Lighting"
cuelist 702 tracking true
sel group 40
set intensity 40%
sel group 37
set intensity 60%
preset color 5
record cue 702/1 "Audience Glow"
sel group 1
set intensity 70%
preset color 1
preset position 6
preset beam 1
effect add "Pan Sweep" id move bpm "Beat" x 0.25 size 30 phase 0 180 wings 2
record cue 702/2 "Audience Sweep"
sel group 37
effect add "Rainbow" id col bpm "Beat" x 0.25 phase 0 360
sel group 1
effect add "Color Chase" id col2 bpm "Beat" x 0.5 phase 0 360
record cue 702/3 "Audience Colour"
sel group 38
preset intensity 5
record cue 702/4 "Audience Hit"
sel group 38
preset intensity 1
sel group 40
set intensity 40%
record cue 702/5 "Audience Glow Again"
clear
cue 702/1 time 2
cue 702/2 time 2
cue 702/2 time position 3
cue 702/3 time 1
cue 702/4 time 0/1
cue 702/5 time 2
cue 702/5 wait 0.3

# --------------------------------------- single looks
sel group 38
preset intensity 5
cuelist add 703 "Audience Blinders"
record cue 703/1
clear
sel group 26
set intensity 80%
preset color 8
sel group 33
preset position 15
preset beam 3
sel group 31
set intensity 70%
preset color 1
preset position 5
preset beam 1
cuelist add 704 "MC Light"                      # announcements between acts
record cue 704/1
clear
cue 704/1 time 2

# --------------------------------------- emergency: HOUSE FULL and PANIC
# Band 200 sits above every playback and the programmer; at band 200 a fog
# level of 0 kills the smoke whatever plays below.
sel group 38
preset intensity 5
set shutter open
set effect off
sel group 37
preset intensity 5
preset color 1
set effect on
sel group 16
preset intensity 5
preset color 1
set shutter open
sel group 7
preset intensity 1
cuelist add 709 "HOUSE FULL"
record cue 709/1
clear
sel group 9
preset intensity 5
sel group 8
preset color 1
sel group 6, group 4, group 5
set shutter open
sel group 5
set effect off
sel group 3
set effect on
sel group 1
preset position 5
sel group 2
preset position 15
sel group 6
preset beam 3
sel group 7
preset intensity 1
cuelist add 710 "PANIC WORK LIGHT"
record cue 710/1
clear

playback add 701 cuelist 701 at 7.1 "House Lights"
playback add 702 cuelist 702 at 7.2 "Audience Lighting"
playback add 703 cuelist 703 at 7.3 "Audience Blinders"
playback add 704 cuelist 704 at 7.4 "MC Light"
playback add 709 cuelist 709 at 7.9 "HOUSE FULL"
playback add 710 cuelist 710 at 7.10 "PANIC WORK LIGHT"
playback 701 buttons ["go", "back", "release"]
playback 702 buttons ["go", "back", "release"]
playback 701 releaseTime 5
playback 702 releaseTime 3
playback 703 buttons ["flash", "toggle", "release"]
playback 703 releaseTime 0.5
playback 704 buttons ["toggle", "flash", "release"]
playback 704 releaseTime 2
playback 709 priority 200
playback 710 priority 200
playback 709 fader none
playback 710 fader none
playback 709 autoStart false
playback 710 autoStart false
playback 709 autoRelease false
playback 710 autoRelease false
playback 709 protectFromSwop true
playback 710 protectFromSwop true
playback 709 releaseTime 3
playback 710 releaseTime 2
playback 709 buttons ["toggle", "release"]
playback 710 buttons ["toggle", "release"]

# --------------------------------------- the emergency pair on every page
page 1 slot 9 playback 709
page 1 slot 10 playback 710
page 2 slot 9 playback 709
page 2 slot 10 playback 710
page 3 slot 9 playback 709
page 3 slot 10 playback 710
page 4 slot 9 playback 709
page 4 slot 10 playback 710
page 5 slot 9 playback 709
page 5 slot 10 playback 710
page 6 slot 9 playback 709
page 6 slot 10 playback 710

# ================================================================ safety
# Nothing strobes or flashes faster than 10 Hz. For a venue that follows
# photosensitivity guidance, use `safety strobe 3`.
safety strobe 10

# ============================================================== surfaces
# The web remote: open the "Web s-..." address busk prints on a tablet on the
# same network. Its header has blackout, the grand master, TAP ("Beat") and
# every other master; its strips are the current page's playbacks.
surface add web "Tablet"

# Play it from a Korg nanoKONTROL2 in its factory CC mode (set its LED mode to
# "external" in the Korg Kontrol Editor, so the LEDs follow the show).
#
#   faders 1–8          the playbacks of slots 1–8 on the current page
#   S / M / R           the playback's buttons: GO / BACK / release on
#                       page 1 and page 7's cue lists, flash / toggle /
#                       release on the strobes and blinders, else toggle /
#                       flash / release
#   knobs 1–6           the group masters "Spots", "Washes", "PARs",
#                       "LED Bars", "Strobes" and "Smoke" (the fog level)
#   knob 7, cycle       "Beat": its multiplier (×¼ … ×4), tap the tempo
#   knob 8, ■           the grand master, blackout on and off
#   ▶ / ●               HOUSE FULL / PANIC WORK LIGHT on and off (slots 9
#                       and 10 of every page)
#   ◀◀ / ▶▶             jump to page 1 (Songs) / page 7 (House & Audience)
#   marker ◀ / ▶        previous / next page (the faders take over softly)
#   marker SET          release every playback
#   track ◀ / ▶         not bound
#
# ------------------------------------------------- nanoKONTROL2 (CC mode)
surface add midi "nanoKONTROL2"
bind "nanoKONTROL2" cc 1 0 fader 1
bind "nanoKONTROL2" cc 1 1 fader 2
bind "nanoKONTROL2" cc 1 2 fader 3
bind "nanoKONTROL2" cc 1 3 fader 4
bind "nanoKONTROL2" cc 1 4 fader 5
bind "nanoKONTROL2" cc 1 5 fader 6
bind "nanoKONTROL2" cc 1 6 fader 7
bind "nanoKONTROL2" cc 1 7 fader 8
bind "nanoKONTROL2" cc 1 32 button 1 1
bind "nanoKONTROL2" cc 1 33 button 2 1
bind "nanoKONTROL2" cc 1 34 button 3 1
bind "nanoKONTROL2" cc 1 35 button 4 1
bind "nanoKONTROL2" cc 1 36 button 5 1
bind "nanoKONTROL2" cc 1 37 button 6 1
bind "nanoKONTROL2" cc 1 38 button 7 1
bind "nanoKONTROL2" cc 1 39 button 8 1
bind "nanoKONTROL2" cc 1 48 button 1 2
bind "nanoKONTROL2" cc 1 49 button 2 2
bind "nanoKONTROL2" cc 1 50 button 3 2
bind "nanoKONTROL2" cc 1 51 button 4 2
bind "nanoKONTROL2" cc 1 52 button 5 2
bind "nanoKONTROL2" cc 1 53 button 6 2
bind "nanoKONTROL2" cc 1 54 button 7 2
bind "nanoKONTROL2" cc 1 55 button 8 2
bind "nanoKONTROL2" cc 1 64 button 1 3
bind "nanoKONTROL2" cc 1 65 button 2 3
bind "nanoKONTROL2" cc 1 66 button 3 3
bind "nanoKONTROL2" cc 1 67 button 4 3
bind "nanoKONTROL2" cc 1 68 button 5 3
bind "nanoKONTROL2" cc 1 69 button 6 3
bind "nanoKONTROL2" cc 1 70 button 7 3
bind "nanoKONTROL2" cc 1 71 button 8 3
bind "nanoKONTROL2" cc 1 23 master gm
bind "nanoKONTROL2" cc 1 42 blackout

# ------------------------------------------------- nanoKONTROL2: group masters and tempo
bind "nanoKONTROL2" cc 1 16 master "Spots"     # knob 1
bind "nanoKONTROL2" cc 1 17 master "Washes"    # knob 2
bind "nanoKONTROL2" cc 1 18 master "PARs"      # knob 3
bind "nanoKONTROL2" cc 1 19 master "LED Bars"  # knob 4
bind "nanoKONTROL2" cc 1 20 master "Strobes"   # knob 5
bind "nanoKONTROL2" cc 1 21 master "Smoke"     # knob 6: the fog level
bind "nanoKONTROL2" cc 1 22 master "Beat"      # knob 7: the multiplier
bind "nanoKONTROL2" cc 1 46 tap "Beat"         # cycle: tap tempo (two speed masters: name one)

# ------------------------------------------------- nanoKONTROL2: emergency and page jumps
bind "nanoKONTROL2" cc 1 41 button 9 1         # ▶: HOUSE FULL on/off
bind "nanoKONTROL2" cc 1 45 button 10 1        # ●: PANIC WORK LIGHT on/off
bind "nanoKONTROL2" cc 1 43 page 1             # ◀◀: Songs
bind "nanoKONTROL2" cc 1 44 page 7             # ▶▶: House & Audience

# ======================================================== pages
# After a page change a fader does nothing until it passes the playback's
# level (soft takeover).
surface "nanoKONTROL2" pickup soft

# ------------------------------------------------ nanoKONTROL2: pages and LEDs (LED mode: external)
bind "nanoKONTROL2" cc 1 61 page -1           # marker ◀
bind "nanoKONTROL2" cc 1 62 page +1           # marker ▶
feedback "nanoKONTROL2" cc 1 32 thru 39 led   # S: the slot's playback is active (a strobe: flash held)
feedback "nanoKONTROL2" cc 1 48 thru 55 led   # M: flash held (BACK or a strobe's toggle: active)
feedback "nanoKONTROL2" cc 1 64 thru 71 led   # R: active
feedback "nanoKONTROL2" cc 1 41 thru 45 led   # ▶ HOUSE FULL on, ■ blackout, ◀◀ / ▶▶ on that page, ● PANIC on
feedback "nanoKONTROL2" cc 1 46 led           # cycle: the beat

# ------------------------------------------------ panic on marker SET
bind "nanoKONTROL2" cc 1 60 release all

save
