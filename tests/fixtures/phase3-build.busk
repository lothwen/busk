# Phase 3 done criterion: a complete busking show built from `busk new` with
# console commands only, no JSON. Run it with
#
#   busk new club.show --title "Club Night"
#   busk run club.show --script tests/fixtures/phase3-build.busk [--iface eth0]
#
# then busk from a Korg nanoKONTROL2 in factory CC mode, as in the Phase 2
# demo (faders 1–8: playbacks, S/M/R buttons: toggle/flash/release, knob 8:
# grand master, ■: blackout on and off).

# ---------------------------------------------------------------- patch
universe add 1 "Stage"
fixture add 101 thru 102 "Generic Spot 16ch" mode 16ch at 1.1
fixture add 201 thru 204 "Eurolite LED ML-56 RGBW" mode 4-channel at 1.33
fixture add 301 "Chauvet DJ COLORband PiX" mode 36-CH at 1.49

# --------------------------------------------------------------- groups
sel fixture 101 thru 102
record group 1 "Heads"
sel fixture 201 thru 204
record group 2 "Washes"
sel fixture 301
record group 3 "Bar"
sel group 1, group 2, group 3
record group 4 "All"

# -------------------------------------------- colour presets (global)
set color 0 0 1
record preset color 1 "Blue"
set color 1 0 0
record preset color 2 "Red"
set color 0 1 0
record preset color 3 "Green"
set color 1 0.5 0
record preset color 4 "Amber"
clear

# ----------------------------------------- position presets (per head)
sel group 1
set pan spread -30 30
set tilt 40
record preset position 1 "Audience"
set pan spread 15 -15
set tilt 10
record preset position 2 "Centre"
clear

# ------------------------------------------------------- base looks
sel group 4
set intensity 80%
set color 1 0.75 0.45
record slot 1 "Warm"
set color 0.75 0.85 1
record slot 2 "Cool"
clear

# ------------------------------------------------------- colour bumps
sel group 4
preset color 1
record slot 3 "Blue"
preset color 2
record slot 4 "Red"
preset color 3
record slot 5 "Green"
clear

# ----------------------------------------------------- position bumps
sel group 1
preset position 1
record slot 6 "Audience"
preset position 2
record slot 7 "Centre"
clear

# --------------------------------------------------------------- panic
sel group 4
set intensity 100%
set color 1 1 1
record slot 8 "Panic"
clear

# ---------------------------------------------------- playback behaviour
playback 1 exclusivity base
playback 2 exclusivity base
playback 3 exclusivity color
playback 4 exclusivity color
playback 5 exclusivity color
playback 6 exclusivity position
playback 7 exclusivity position
cue 3/1 timing.fadeIn 1
cue 4/1 timing.fadeIn 1
cue 5/1 timing.fadeIn 1
cue 6/1 timing.fadeIn 2
cue 7/1 timing.fadeIn 2
playback 6 ltpFaderMode followFader
playback 7 ltpFaderMode followFader
playback 6 releaseTime 2
playback 7 releaseTime 2
playback 8 priority 200
playback 8 fader none
playback 8 autoStart false
playback 8 autoRelease false
playback 8 releaseTime 0
playback 1 buttons ["toggle", "flash", "release"]
playback 2 buttons ["toggle", "flash", "release"]
playback 3 buttons ["toggle", "flash", "release"]
playback 4 buttons ["toggle", "flash", "release"]
playback 5 buttons ["toggle", "flash", "release"]
playback 6 buttons ["toggle", "flash", "release"]
playback 7 buttons ["toggle", "flash", "release"]
playback 8 buttons ["toggle", "flash", "release"]

# -------------------------------------------------------------- output
route add 1 sacn 1

# ------------------------------------------------- nanoKONTROL2 (CC mode)
surface add midi "nanoKONTROL2"
bind "nanoKONTROL2" cc 1 0 fader 1
bind "nanoKONTROL2" cc 1 1 fader 2
bind "nanoKONTROL2" cc 1 2 fader 3
bind "nanoKONTROL2" cc 1 3 fader 4
bind "nanoKONTROL2" cc 1 4 fader 5
bind "nanoKONTROL2" cc 1 5 fader 6
bind "nanoKONTROL2" cc 1 6 fader 7
bind "nanoKONTROL2" cc 1 7 fader 8
bind "nanoKONTROL2" cc 1 32 button 1 1
bind "nanoKONTROL2" cc 1 33 button 2 1
bind "nanoKONTROL2" cc 1 34 button 3 1
bind "nanoKONTROL2" cc 1 35 button 4 1
bind "nanoKONTROL2" cc 1 36 button 5 1
bind "nanoKONTROL2" cc 1 37 button 6 1
bind "nanoKONTROL2" cc 1 38 button 7 1
bind "nanoKONTROL2" cc 1 39 button 8 1
bind "nanoKONTROL2" cc 1 48 button 1 2
bind "nanoKONTROL2" cc 1 49 button 2 2
bind "nanoKONTROL2" cc 1 50 button 3 2
bind "nanoKONTROL2" cc 1 51 button 4 2
bind "nanoKONTROL2" cc 1 52 button 5 2
bind "nanoKONTROL2" cc 1 53 button 6 2
bind "nanoKONTROL2" cc 1 54 button 7 2
bind "nanoKONTROL2" cc 1 55 button 8 2
bind "nanoKONTROL2" cc 1 64 button 1 3
bind "nanoKONTROL2" cc 1 65 button 2 3
bind "nanoKONTROL2" cc 1 66 button 3 3
bind "nanoKONTROL2" cc 1 67 button 4 3
bind "nanoKONTROL2" cc 1 68 button 5 3
bind "nanoKONTROL2" cc 1 69 button 6 3
bind "nanoKONTROL2" cc 1 70 button 7 3
bind "nanoKONTROL2" cc 1 71 button 8 3
bind "nanoKONTROL2" cc 1 23 master gm
bind "nanoKONTROL2" cc 1 42 blackout

save
